# Repositori privat tim EsTehPlastik. Daftar ini sengaja pendek: hanya berkas
# yang benar-benar tidak boleh masuk repo (rahasia, hasil build dependensi,
# berkas editor lokal). Dataset Rapor Pendidikan justru di-commit supaya repo
# bisa langsung dijalankan setelah clone.

# Rahasia dan lingkungan
.env
.env.*
!.env.example
!.env.production.example
/auth.json
/storage/*.key

# Dependensi (dipasang dengan composer install / npm install)
/vendor
/node_modules

# Artefak runtime
*.log
/public/hot
/public/storage
/storage/pail
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/.phpunit.cache
.phpunit.result.cache
_ide_helper.php
/public/fonts-manifest.dev.json

# Sistem operasi dan editor
.DS_Store
Thumbs.db
/.idea
/.vscode
/.zed
/.nova
/.cursor/
/.codex
/.claude/
Homestead.json
Homestead.yaml

# public/build TIDAK diabaikan: server cPanel tanpa Node.js, aset hasil
# `npm run build` harus ikut ke repo (ARCHITECTURE.md bagian 8.1).
