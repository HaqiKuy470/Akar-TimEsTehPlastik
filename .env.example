APP_NAME=AKAR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Basis data. Untuk pengembangan cepat pakai sqlite:
#   DB_CONNECTION=sqlite  lalu  `touch database/database.sqlite`
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=akar
DB_USERNAME=root
DB_PASSWORD=

# Tanpa Redis: cache, sesi, dan antrean semuanya driver database / file.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Akun super admin awal (pembuat akun; tidak melihat data). Kosongkan untuk
# melewati pembuatannya saat seeding.
SUPERADMIN_NAMA="Super Admin"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
